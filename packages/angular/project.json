{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pixelshift-angular",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng-packagr -p ng-package.json",
        "cwd": "packages/angular"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ngc -p tsconfig.lib.json --noEmit",
        "cwd": "packages/angular"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "packages/angular" }
    }
  }
}
