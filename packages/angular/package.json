{
  "name": "pixelshift-angular",
  "version": "0.1.0",
  "description": "Angular image converter component for local browser PNG, JPEG, and WebP conversion.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/fesm2022/pixelshift-angular.mjs",
  "module": "./dist/fesm2022/pixelshift-angular.mjs",
  "types": "./dist/types/pixelshift-angular.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pixelshift-web-core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "keywords": [
