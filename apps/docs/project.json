{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": { "command": "next build --webpack", "cwd": "apps/docs" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "next dev", "cwd": "apps/docs" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next typegen && tsc --noEmit",
        "cwd": "apps/docs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "apps/docs" }
    }
  }
}
