{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "react-app",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build", "cwd": "apps/react-app" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "vite", "cwd": "apps/react-app" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "apps/react-app"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "apps/react-app" }
    }
  }
}
